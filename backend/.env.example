# Backend Environment Variables
# Copy this file to backend/.env for local development:
#   cp .env.example .env
#
# Deployment note:
# On Render (backend) and Vercel (frontend), configure these variables in the
# platform dashboard — never commit a real .env file to Git.

# HTTP server listening port.
# Optional — default: 3001
PORT=3001

# PostgreSQL connection string used by the API, worker, migrate, and seed scripts.
# Required — no default
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Secret key used to sign and verify JWT authentication tokens.
# Optional in local dev (code falls back to 'fallback-secret-for-dev'), required for security in production.
JWT_SECRET=change_me_to_a_long_random_string

# Set to 'true' to disable running the Kafka consumer inside index.js (e.g. when running consumerWorker.js separately).
# Optional — default: unset (in-process consumer runs automatically)
DISABLE_IN_PROCESS_CONSUMER=false

# ==============================================================================
# Kafka Configuration
# ==============================================================================

# Comma-separated list of Kafka broker host:port addresses.
# Required for Kafka producer/consumer — default: [] (empty list if unset)
KAFKA_BROKERS=your-kafka-host:port

# Kafka client identifier used by producer, consumer, and simulator.
# Optional — default: inventory-app
KAFKA_CLIENT_ID=inventory-app

# Kafka consumer group ID.
# Optional — default: inventory-consumer-group
KAFKA_GROUP_ID=inventory-consumer-group

# Kafka topic name for inventory purchase and sale events.
# Optional — default: inventory-events
KAFKA_TOPIC=inventory-events

# Set to 'true' to enable TLS/SSL connections to Kafka.
# Optional — default: unset (TLS disabled)
KAFKA_SSL=true

# Two ways to provide the Kafka CA certificate when KAFKA_SSL=true:
#   1) KAFKA_SSL_CA: inline PEM certificate text (recommended on Render; '\n' escaped newlines are supported).
#      Takes precedence over KAFKA_SSL_CA_PATH if both are set.
#   2) KAFKA_SSL_CA_PATH: filesystem path to the CA PEM file (convenient for local development).
# If neither is set while KAFKA_SSL=true, Node's default trust store is used.
# Optional — no default
# KAFKA_SSL_CA="-----BEGIN CERTIFICATE-----\nYOUR_CA_CERTIFICATE_PEM_CONTENT\n-----END CERTIFICATE-----"
# Optional — no default
# KAFKA_SSL_CA_PATH=./ca.pem

# Client TLS certificate and private key paths for mutual TLS (mTLS) authentication.
# Both service.cert and service.key are OPTIONAL and only needed if your Kafka provider
# uses client-certificate login (instead of or in addition to SASL username/password).
# Optional — no default
# KAFKA_SSL_CERT_PATH=./service.cert
# Optional — no default
# KAFKA_SSL_KEY_PATH=./service.key

# SASL authentication mechanism used when KAFKA_USERNAME and KAFKA_PASSWORD are set.
# Optional — default: scram-sha-256
KAFKA_SASL_MECHANISM=scram-sha-256

# SASL username for Kafka authentication (used with KAFKA_PASSWORD).
# Optional (required if broker enforces SASL) — no default
KAFKA_USERNAME=your_kafka_username

# SASL password for Kafka authentication (used with KAFKA_USERNAME).
# Optional (required if broker enforces SASL) — no default
KAFKA_PASSWORD=your_kafka_password
