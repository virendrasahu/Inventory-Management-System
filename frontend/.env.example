# Frontend Environment Variables (Vite)
# Copy this file to frontend/.env for local development:
#   cp .env.example .env
#
# Deployment note:
# On Vercel (frontend) and Render (backend), configure these variables in the
# platform dashboard — never commit a real .env file to Git.

# Base URL of the backend Express API (without trailing slash).
# Optional — default: http://localhost:3001
VITE_API_URL=http://localhost:3000
