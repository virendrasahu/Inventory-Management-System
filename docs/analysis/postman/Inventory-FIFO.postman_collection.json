                  "    pm.expect(jsonData).to.have.property('message').that.is.a('string');",
                  "    pm.expect(jsonData).to.have.property('errors').that.is.an('array').and.not.empty;",
                  "    pm.expect(jsonData.errors.some(e => e.field === 'quantity')).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Purchase Without unit_price (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_id\": \"PRD001\",\n  \"event_type\": \"purchase\",\n  \"quantity\": 10\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/event",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "event"
              ]
            },
            "description": "Verifies purchase events require unit_price > 0 and return HTTP 400 otherwise."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test('Validation error identifies unit_price', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('success', false);",
                  "    pm.expect(jsonData).to.have.property('errors').that.is.an('array').and.not.empty;",
                  "    pm.expect(jsonData.errors.some(e => e.field === 'unit_price')).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Protected Route Without Token (401)",
          "request": {
            "auth": {
