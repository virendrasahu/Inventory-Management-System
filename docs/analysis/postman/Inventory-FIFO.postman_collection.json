    {
      "name": "FIFO scenario",
      "description": "Ordered end-to-end FIFO verification on a clean product (uses unique SKU PRD-TEST-<run> or PRD-TEST).\n\nIMPORTANT ASYNC NOTE:\nPOST /api/event publishes asynchronously to Kafka. Request #4 includes a 2.5s pre-request delay to let consumerWorker.js process the 3 Kafka messages into PostgreSQL. Ensure both the API server and consumerWorker.js are running (e.g. npm run dev:all) and PRD-TEST starts with 0 stock before running this folder.",
      "item": [
        {
          "name": "1. Purchase PRD-TEST 50 @ 100",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_id\": \"PRD-TEST\",\n  \"event_type\": \"purchase\",\n  \"quantity\": 50,\n  \"unit_price\": 100\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/event",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "event"
              ]
            }
          },
          "event": [
            {
              "listen": "pre-request",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Ensure first purchase has an earlier timestamp than second purchase",
                  "setTimeout(function () {}, 200);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Purchase 1 pushed', function () {",
                  "    pm.expect(pm.response.json()).to.have.property('success', true);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Purchase PRD-TEST 30 @ 120",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_id\": \"PRD-TEST\",\n  \"event_type\": \"purchase\",\n  \"quantity\": 30,\n  \"unit_price\": 120\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/event",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "event"
              ]
            }
          },
          "event": [
            {
              "listen": "pre-request",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Small delay so timestamp ordering is strictly after batch 1",
                  "setTimeout(function () {}, 200);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Purchase 2 pushed', function () {",
                  "    pm.expect(pm.response.json()).to.have.property('success', true);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Sale PRD-TEST 60 units",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_id\": \"PRD-TEST\",\n  \"event_type\": \"sale\",\n  \"quantity\": 60\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/event",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "event"
              ]
            }
          },
          "event": [
            {
              "listen": "pre-request",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "setTimeout(function () {}, 200);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Sale pushed', function () {",
                  "    pm.expect(pm.response.json()).to.have.property('success', true);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Verify Stock (Remaining Qty = 20, Cost = 2400)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/stock",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "stock"
              ]
            },
            "description": "Waits 2.5s before sending so async Kafka consumer commits FIFO transactions, then verifies PRD-TEST remaining_quantity = 20, total_inventory_cost = 2400, average_cost_per_unit = 120."
          },
          "event": [
            {
              "listen": "pre-request",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Wait for async Kafka consumer to process the 3 events",
                  "setTimeout(function () {}, 2500);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const stock = pm.response.json();",
                  "const item = stock.find(s => s.product_id === 'PRD-TEST');",
                  "pm.test('PRD-TEST exists in stock overview', function () {",
                  "    pm.expect(item, 'PRD-TEST should be present after consumer processes Kafka events').to.not.be.undefined;",
                  "});",
                  "if (item) {",
                  "    pm.test('Remaining quantity is 20', function () {",
                  "        pm.expect(Number(item.current_quantity)).to.eql(20);",
                  "    });",
                  "    pm.test('Remaining inventory cost is 2400', function () {",
                  "        pm.expect(Number(item.total_inventory_cost)).to.eql(2400);",
                  "    });",
                  "    pm.test('Average cost per unit is 120', function () {",
                  "        pm.expect(Number(item.average_cost_per_unit)).to.eql(120);",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "5. Verify Ledger (Sale FIFO Cost = 6200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/ledger",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "ledger"
              ]
            },
            "description": "Verifies the latest sale for PRD-TEST (quantity 60) has FIFO total_value = 6200 (50*100 + 10*120)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const ledger = pm.response.json();",
                  "const sale = ledger.find(tx => tx.product_id === 'PRD-TEST' && tx.type === 'sale' && Number(tx.quantity) === 60);",
                  "pm.test('PRD-TEST sale of 60 units recorded in ledger', function () {",
                  "    pm.expect(sale).to.not.be.undefined;",
                  "});",
                  "if (sale) {",
                  "    pm.test('FIFO sale cost equals 6200', function () {",
                  "        pm.expect(Number(sale.total_value)).to.eql(6200);",
                  "    });",
                  "    pm.test('Sale unit price is null in ledger', function () {",
                  "        pm.expect(sale.price).to.be.null;",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
